{
	"name": "sazanami",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:cf": "vite build && echo 'Checking for unsafe nodemailer imports...' && ! grep -E 'await import\\(\"nodemailer\"\\)' .svelte-kit/cloudflare/_worker.js && echo '✓ Worker bundle looks good'",
		"dev:cf": "wrangler pages dev .svelte-kit/cloudflare -- bun run build --watch",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"test": "vitest",
		"test:unit": "vitest tests/unit",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1164.0",
		"@better-auth/passkey": "1.7.18",
		"@jsquash/avif": "^2.1.1",
		"@libsql/client": "^0.15.15",
		"@tiptap/core": "^3.33.0",
		"@tiptap/extension-code-block-lowlight": "^3.33.0",
		"@tiptap/extension-drag-handle": "^3.33.0",
		"@tiptap/extension-image": "^3.33.0",
		"@tiptap/extension-link": "^3.33.0",
		"@tiptap/extension-list": "^3.33.0",
		"@tiptap/extension-placeholder": "^3.33.0",
		"@tiptap/extension-table": "^3.33.0",
		"@tiptap/extension-table-cell": "^3.33.0",
		"@tiptap/extension-table-header": "^3.33.0",
		"@tiptap/extension-table-row": "^3.33.0",
		"@tiptap/extension-task-item": "^3.33.0",
		"@tiptap/extension-task-list": "^3.33.0",
		"@tiptap/markdown": "^3.33.0",
		"@tiptap/pm": "^3.33.0",
		"@tiptap/starter-kit": "^3.33.0",
		"@types/jszip": "^3.4.1",
		"@types/qrcode": "^1.5.6",
		"better-auth": "1.7.18",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.4",
		"highlight.js": "^11.12.0",
		"jszip": "^3.10.2",
		"lowlight": "^3.3.0",
		"marked": "^16.4.2",
		"marked-highlight": "^2.2.4",
		"qrcode": "^1.5.4",
		"remark-wiki-link": "^2.0.1",
		"turndown": "^7.2.5",
		"ulid": "^3.0.2",
		"y-prosemirror": "^1.3.7"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-cloudflare": "^6.0.1",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^24.19.2",
		"@types/nodemailer": "^7.0.12",
		"@types/scrypt-js": "^3.0.1",
		"@types/turndown": "^5.0.6",
		"daisyui": "^5.7.50",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^16.5.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^7.3.8",
		"vitest": "^4.1.12"
	},
	"overrides": {
		"wasm-feature-detect": "1.9.0"
	}
}
