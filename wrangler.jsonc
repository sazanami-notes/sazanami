{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sazanami",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-05-12",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"STORAGE_DRIVER": "r2",
		"BETTER_AUTH_URL": "https://sazanami.kaedesato.work",
		"EMAIL_DRIVER": "plunk"
	},
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "sazanami-images"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"env": {
		"dev": {
			"name": "sazanami-dev",
			"ai": {
				"binding": "AI"
			},
			"vars": {
				"STORAGE_DRIVER": "r2",
				"BETTER_AUTH_URL": "https://sazanami-dev.kaedesato.work",
				"EMAIL_DRIVER": "plunk"
			},
			"r2_buckets": [
				{
					"binding": "R2",
					"bucket_name": "sazanami-images"
				}
			]
		}
	}
}
